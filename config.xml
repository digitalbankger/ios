<?xml version="1.0" encoding="utf-8"?>
<widget id="ru.daigo.appmobile"
        version="1.3.1"
        android-versionCode="131"
        ios-CFBundleVersion="2"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>Daigo</name>
    <description>Официальное мобильное приложение DAIGO.</description>
    <author email="gheraev@gmail.com" href="https://daigo.ru">DAIGO</author>

    <content src="index.html" />

    <access origin="*" />
    <allow-navigation href="https://api.daigo.ru/*" />
    <allow-navigation href="https://daigo.ru/*" />
    <allow-navigation href="https://*.daigo.ru/*" />
    <allow-navigation href="https://*.yandex.ru/*" />
    <allow-navigation href="https://*.dadata.ru/*" />
    <allow-navigation href="https://geocode.maps.co/*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />

    <preference name="WKWebViewOnly" value="true" />
    <preference name="ScrollEnabled" value="false" />
    <preference name="BackupWebStorage" value="none" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="250" />
    <preference name="SplashScreenDelay" value="700" />
    <preference name="SplashScreenBackgroundColor" value="#FFFFFF" />

    <engine name="android" spec="14.0.1" />
    <engine name="ios" spec="8.1.1" />

    <plugin name="cordova-plugin-inappbrowser" spec="7.0.0" />
    <plugin name="cordova-plugin-geolocation" spec="5.0.0">
        <variable name="GPS_REQUIRED" value="true" />
    </plugin>
    <plugin name="cordova-plugin-customurlscheme" spec="5.0.2">
        <variable name="URL_SCHEME" value="daigoapp" />
    </plugin>
    <plugin name="cordova-plugin-statusbar" spec="4.0.0" />

    <hook
        type="after_platform_add"
        src="scripts/force-ios-only.cjs"
    />
    
    <platform name="android">
        <icon src="res/icon.png" />
        <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
        <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
        <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    </platform>

    <platform name="ios">
        <preference name="deployment-target" value="13.0" />
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarStyle" value="default" />
        <preference name="StatusBarBackgroundColor" value="#FFFFFF" />
        <preference name="DisallowOverscroll" value="true" />
        <preference name="KeyboardDisplayRequiresUserAction" value="false" />

        <icon src="res/ios/icon-1024.png" width="1024" height="1024" />
        <splash src="res/ios/Default@2x~universal~anyany.png" />
        <splash src="res/ios/Default@3x~universal~anyany.png" />

        <edit-config file="*-Info.plist" mode="merge" target="NSLocationWhenInUseUsageDescription">
            <string>Геолокация нужна для определения вашего города и расчёта доставки.</string>
        </edit-config>
        <edit-config file="*-Info.plist" mode="merge" target="NSPhotoLibraryUsageDescription">
            <string>Доступ к медиатеке нужен для прикрепления фотографий к материалам и отзывам.</string>
        </edit-config>
        <edit-config file="*-Info.plist" mode="merge" target="NSCameraUsageDescription">
            <string>Камера нужна для добавления фотографии с устройства.</string>
        </edit-config>
        <edit-config file="*-Info.plist" mode="merge" target="ITSAppUsesNonExemptEncryption">
            <false />
        </edit-config>
    </platform>
</widget>
