{
  "name": "daigo-mobile-app",
  "private": true,
  "version": "1.3.1",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:api": "node scripts/verify-api-contract.mjs",
    "build:checked": "npm run verify:api && vite build",
    "appflow:build": "npm run build:checked",
    "cordova:prepare:ios": "cordova platform add ios@7.1.1 && cordova prepare ios",
    "cordova:prepare:android": "cordova platform add android@14.0.1 && cordova prepare android"
  },
  "dependencies": {
    "@vueuse/core": "^12.5.0",
    "axios": "^1.7.9",
    "pinia": "2.3.1",
    "pinia-plugin-persistedstate": "4.2.0",
    "swiper": "^11.2.1",
    "vue": "^3.5.13",
    "vue-cordova": "^0.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "cordova": "13.0.0",
    "cordova-android": "14.0.1",
    "cordova-ios": "7.1.1",
    "cordova-plugin-customurlscheme": "5.0.2",
    "cordova-plugin-geolocation": "5.0.0",
    "cordova-plugin-inappbrowser": "7.0.0",
    "cordova-plugin-statusbar": "4.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.3.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "cordova-plugin-customurlscheme": {
        "URL_SCHEME": "daigoapp"
      },
      "cordova-plugin-statusbar": {}
    },
    "platforms": [
      "android",
      "ios"
    ]
  },
  "description": "DAIGO mobile application (Vue + Cordova) prepared for Ionic Appflow iOS/Android builds.",
  "engines": {
    "node": ">=20.17.0"
  }
}
